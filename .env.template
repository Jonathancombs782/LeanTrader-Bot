# Environment Configuration Template — CANONICAL (single source of truth)
# Copy this to .env and fill in your actual values. Never commit .env.
# Consolidated Nov 11, 2026 (B5): .env.example was merged into this file
# and removed. ENABLE_LIVE=false is the only live flag here (the old
# example set it true AND false in the same file); BYBIT_TESTNET=true
# (the old example's false contradicted this file). See docs/CONFIG.md.

# =============================================================================
# TRADING MODE CONFIGURATION
# =============================================================================
# Set to "true" to enable live trading (requires valid API keys)
ENABLE_LIVE=false
ALLOW_LIVE=false
LIVE_CONFIRM=NO

# =============================================================================
# EXCHANGE API KEYS
# =============================================================================
# Bybit API (for crypto trading)
BYBIT_API_KEY=
BYBIT_SECRET_KEY=
BYBIT_SANDBOX=true
BYBIT_TESTNET=true

# Binance API (alternative crypto exchange)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# Host matching the account the key was made on (default: Binance.US)
# Binance.com: https://api.binance.com
# Spot testnet (no real money): https://testnet.binance.vision
BINANCE_BASE_URL=https://api.binance.us
# Live orders stay OFF unless this is exactly 1 (paper-first)
BINANCE_ALLOW_LIVE_ORDERS=
BINANCE_SANDBOX=true
BINANCE_TESTNET=true

# Coinbase Pro API
COINBASE_API_KEY=
COINBASE_SECRET_KEY=
COINBASE_PASSPHRASE=
COINBASE_SANDBOX=true

# Interactive Brokers (for forex/stocks)
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=1

# =============================================================================
# TRADING PARAMETERS
# =============================================================================
INITIAL_CAPITAL=10000
MAX_POSITION_SIZE=0.1
MAX_POSITIONS=10
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.1
MIN_CONFIDENCE=0.7

# Risk Management
MAX_TOTAL_EXPOSURE=0.8
MAX_DRAWDOWN=0.15
MAX_VAR=0.05
MAX_CORRELATION=0.7
MAX_CONCENTRATION=0.3

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# Email (optional)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# =============================================================================
# DASHBOARD & MONITORING
# =============================================================================
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0
LOG_LEVEL=INFO

# =============================================================================
# ML CONFIGURATION
# =============================================================================
MODEL_RETRAIN_HOURS=24
LOOKBACK_PERIOD=1000
FEATURE_WINDOW=50
PREDICTION_HORIZON=5

# =============================================================================
# EXCHANGE-SPECIFIC SETTINGS
# =============================================================================
# CCXT timeout and rate limiting
CCXT_TIMEOUT_MS=15000
CCXT_RATE_LIMIT=60

# Default exchange selection
DEFAULT_EXCHANGE=bybit
EXCHANGE_MODE=spot

# =============================================================================
# LEGACY / MERGED KEYS (from .env.example, Nov 11, 2026 consolidation)
# =============================================================================
# .env.example was merged into this file and removed — this is the ONE
# canonical template. Keys below are read by legacy modules; new code
# should use the sections above.
# Forex adapters
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
# MetaTrader 5 (local terminal only)
MT5_LOGIN=<YOUR_MT5_LOGIN>
MT5_PASSWORD=<YOUR_MT5_PASSWORD>
MT5_SERVER=<YOUR_MT5_SERVER>
# Generic keys required by the root router's live gate (router.py). The
# per-exchange keys above are canonical; these exist only because the
# legacy router reads them.
API_KEY=
API_SECRET=
# Paper-mode cash (legacy alias of INITIAL_CAPITAL above; smoke_test only)
PAPER_START_CASH=10000
# Order sizing / safety (legacy daemon)
MAX_ORDER_SIZE=0.01
LIVE_ORDER_USD=10.0
LIVE_ORDER_AMOUNT=
ATR_STOP_MULT=1.0
ATR_TRAIL_MULT=0.5
# Circuit-breaker / daemon
CIRCUIT_BREAKER_ENABLED=true
DAILY_MAX_LOSS=100.0
POLL_INTERVAL=60
# Timeouts / debug
CCXT_DEBUG=false
# Redis for signal bus
REDIS_URL=redis://localhost:6379/0
# Web3 publisher controls (WEB3_SIGNALS_CONFIG path is legacy/unused)
RUN_WEB3_PUBLISHER=true
WEB3_SIGNALS_CONFIG=lt_plugins/web3_signals/config.yaml
# Optional Etherscan key
ETHERSCAN_API_KEY=
# Strategy plugin loader
STRATEGY_PLUGIN=ratio_arb
STRATEGY_CONFIG=strategies/ratio_arb/config.yaml
# Optional background ratio-arb daemon (poll-based)
RUN_RATIO_ARB=false
RATIO_ARB_CONFIG=runtime/strategies/ratio_arb/config.yaml
# Master toggle for background services (bias, pnl, ratio_arb, publisher)
RUN_DAEMONS=true